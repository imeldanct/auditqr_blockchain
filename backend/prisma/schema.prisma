// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SME {
  smeID           String   @id @default(uuid()) @db.VarChar(36)
  businessName    String   @db.VarChar(150)
  rcNumber        String   @unique @db.VarChar(10)
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @db.VarChar(60)
  isVerified      Boolean  @default(false)
  emailVerified   Boolean  @default(false)
  businessAddress String   @db.VarChar(255)
  businessState   String   @db.VarChar(50)
  createdAt       DateTime @default(now())

  products     Product[]
  authTokens   AuthToken[]
}

model Product {
  productID   String    @id @default(uuid()) @db.VarChar(36)
  smeID       String    @db.VarChar(36)
  productName String    @db.VarChar(150)
  description String
  category    String?   @db.VarChar(50)
  weight      Float?
  mfgDate     DateTime?
  expDate     DateTime?
  createdAt   DateTime  @default(now())

  sme         SME      @relation(fields: [smeID], references: [smeID])
  parentQRs   ParentQRCode[]
}

model ParentQRCode {
  parentQRID    String   @id @default(uuid()) @db.VarChar(36)
  productID     String   @db.VarChar(36)
  qrData        String   @db.VarChar(70)
  currentStage  QRStage  @default(pending)
  genesisTxHash String?  @db.VarChar(88)
  createdAt     DateTime @default(now())

  product      Product      @relation(fields: [productID], references: [productID], onDelete: Cascade)
  childQRs     ChildQRCode[]
  scanEvents   ScanEvent[]
}

enum QRStage {
  pending
  transit
  delivered
}

model ChildQRCode {
  childQRID  String   @id @default(uuid()) @db.VarChar(36)
  parentQRID String   @db.VarChar(36)
  itemNumber Int
  qrData     String   @db.VarChar(70)
  createdAt  DateTime @default(now())

  parentQR   ParentQRCode @relation(fields: [parentQRID], references: [parentQRID], onDelete: Cascade)
}

model ScanEvent {
  scanID      String   @id @default(uuid()) @db.VarChar(36)
  parentQRID  String   @db.VarChar(36)
  scannerRole String   @db.VarChar(20)
  gpsLocation String?  @db.VarChar(150)
  timestamp   DateTime @default(now())
  txHash      String?  @db.VarChar(88)

  parentQR    ParentQRCode @relation(fields: [parentQRID], references: [parentQRID], onDelete: Cascade)
  handoffCode HandoffCode?
}

model HandoffCode {
  codeID    String   @id @default(uuid()) @db.VarChar(36)
  scanID    String   @unique @db.VarChar(36)
  codeValue String   @db.VarChar(4)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  scanEvent ScanEvent @relation(fields: [scanID], references: [scanID])
}

model AuthToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  smeID     String    @db.VarChar(36)
  token     String    @unique @db.VarChar(36)
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  sme       SME @relation(fields: [smeID], references: [smeID], onDelete: Cascade)
}

enum TokenType {
  magic_link
  password_reset
}
